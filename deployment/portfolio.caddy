@portfolio_www host www.younesbenketira.com
redir @portfolio_www https://younesbenketira.com{uri} permanent

@portfolio host younesbenketira.com
handle @portfolio {
    root * /opt/younesbenketira-com/current
    @revalidate not path /bundles/*
    header @revalidate Cache-Control "no-cache"
    @bundles path /bundles/*
    header @bundles Cache-Control "public, max-age=31536000, immutable"
    @resume path /resume /resume/
    handle @resume {
        header Content-Disposition "attachment; filename=Younes-Benketira-Resume.pdf"
        rewrite * /Younes-Benketira-Resume.pdf
        file_server
    }
    file_server
}
